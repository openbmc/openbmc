diff --git a/vendor/cc-1.2.0/src/command_helpers.rs b/vendor/cc-1.2.0/src/command_helpers.rs
index adedab2..c911306 100644
--- a/vendor/cc-1.2.0/src/command_helpers.rs
+++ b/vendor/cc-1.2.0/src/command_helpers.rs
@@ -315,13 +315,25 @@ pub(crate) fn objects_from_files(files: &[Arc<Path>], dst: &Path) -> Result<Vec<
 
         // Make the dirname relative (if possible) to avoid full system paths influencing the sha
         // and making the output system-dependent
+        // compiler-builtins generates sources into OUT_DIR and reads the compiler-rt
+        // intrinsics from RUST_COMPILER_RT_ROOT, so try those before the manifest dir
         //
         // NOTE: Here we allow using std::env::var (instead of Build::getenv) because
         // CARGO_* variables always trigger a rebuild when changed
         #[allow(clippy::disallowed_methods)]
-        let dirname = if let Some(root) = std::env::var_os("CARGO_MANIFEST_DIR") {
-            let root = root.to_string_lossy();
-            Cow::Borrowed(dirname.strip_prefix(&*root).unwrap_or(&dirname))
+        let strip_root = |var: &str| {
+            std::env::var_os(var).and_then(|root| {
+                dirname
+                    .strip_prefix(&*root.to_string_lossy())
+                    .map(str::to_owned)
+            })
+        };
+        let dirname = if let Some(rel) = strip_root("OUT_DIR") {
+            Cow::Owned(rel)
+        } else if let Some(rel) = strip_root("RUST_COMPILER_RT_ROOT") {
+            Cow::Owned(rel)
+        } else if let Some(rel) = strip_root("CARGO_MANIFEST_DIR") {
+            Cow::Owned(rel)
         } else {
             dirname
         };
