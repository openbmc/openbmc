Signed-off-by: Jan Vermaete <jan.vermaete@gmail.com>
---
 pytest.ini | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pytest.ini b/pytest.ini
index f5a52af..4b1b4b6 100644
--- a/pytest.ini
+++ b/pytest.ini
@@ -1,3 +1,3 @@
 [pytest]
 pythonpath = .
-
