 src/lib/ares_close_sockets.c          |   82 +-
 src/lib/ares_conn.c                   |  217 ++++-
 src/lib/ares_conn.h                   |   37 +-
 src/lib/ares_destroy.c                |   85 +-
 src/lib/ares_private.h                |  110 ++-
 src/lib/ares_process.c                |  235 +++++-
 src/lib/ares_send.c                   |   35 +
