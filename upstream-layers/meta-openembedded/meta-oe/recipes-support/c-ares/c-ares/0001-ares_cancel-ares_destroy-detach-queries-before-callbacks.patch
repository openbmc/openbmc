+  EXPECT_EQ(ARES_SUCCESS,
+            ares_query_dnsrec(channel_, "www.google.com", ARES_CLASS_IN,
+                              ARES_REC_TYPE_A, ReconfigureServersCallback,
+                              &data, NULL));
+  EXPECT_EQ(ARES_SUCCESS,
