 src/lib/ares_process.c |  18 ++++
 src/lib/ares_socket.c  |  24 +++++
 src/lib/ares_socket.h  |  21 ++++
 test/ares-test-mock.cc | 218 +++++++++++++++++++++++++++++++++++++++++
 test/ares-test.cc      |  86 +++++++++-------
