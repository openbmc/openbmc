+  HostResult r1;
+  ares_gethostbyname(channel_, "www.google.com.", AF_INET, HostCallback, &r1);
+  Process();
+  EXPECT_TRUE(r1.done_);
+  EXPECT_EQ(ARES_SUCCESS, r1.status_);
