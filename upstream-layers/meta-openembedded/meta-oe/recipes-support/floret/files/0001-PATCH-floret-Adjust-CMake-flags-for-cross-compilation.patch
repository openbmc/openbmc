From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Varun Singhal <varusing@qti.qualcomm.com>
Date: Mon, 21 Sep 2026 10:57:00 +0530
Subject: [PATCH] floret: Adjust CMake flags for cross-compilation

- Update cmake_minimum_required from 2.8.9 to 3.5
- Add missing #include <cstdint> to args.cc for GCC 15.x
- Preserve existing CMAKE_CXX_FLAGS instead of replacing them so that
  Yocto's -ffile-prefix-map flags are not discarded; without this the
  compiled binaries retain references to TMPDIR and fail the
  do_package_qa buildpaths check.

Upstream-Status: Pending [cross-compilation fix for Yocto/OE]
Signed-off-by: Varun Singhal <varusing@qti.qualcomm.com>
---
 CMakeLists.txt | 4 ++--
 src/args.cc    | 1 +
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -6,7 +6,7 @@
 # LICENSE file in the root directory of this source tree.
 #

-cmake_minimum_required(VERSION 2.8.9)
+cmake_minimum_required(VERSION 3.5)
 project(floret)

 # The version number.
@@ -15,7 +15,7 @@ set (floret_VERSION_MINOR 1)

 include_directories(fasttext)

-set(CMAKE_CXX_FLAGS " -pthread -std=c++11 -funroll-loops -O3")
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -pthread -std=c++11 -funroll-loops -O3")

 set(HEADER_FILES
     src/MurmurHash3.h
diff --git a/src/args.cc b/src/args.cc
--- a/src/args.cc
+++ b/src/args.cc
@@ -14,6 +14,7 @@
 #include <stdexcept>
 #include <string>
 #include <unordered_map>
+#include <cstdint>

 namespace fasttext {

--
2.43.0
