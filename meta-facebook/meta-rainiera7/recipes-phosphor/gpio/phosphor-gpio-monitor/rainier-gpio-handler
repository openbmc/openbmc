#!/bin/bash
# shellcheck source=meta-facebook/recipes-fb/obmc_functions/files/fb-common-functions
source /usr/libexec/fb-common-functions

input="$1"
if [[ "$input" != *":"* ]]; then
    echo "Error: Invalid instance format, expected ':' separator"
    exit 1
fi

GPIO_NET="${input%%:*}"
Event="${input#*:}"

BUS11=11
RTC_DEVICE=0x6F
REG_OFFSET=0x0b
CLEAR_BIT=0x07

trigger_ext_warm_reset() {
    set_gpio RST_SOC_EXTWARMRESET_CPLD 1
    sleep 1
    set_gpio RST_SOC_EXTWARMRESET_CPLD 0
}

trigger_host_reboot() {
    systemctl start obmc-host-reboot@0.target
}

trigger_host_poweroff() {
    systemctl start obmc-host-shutdown@0.target
}

press_reset_button() {
    busctl set-property xyz.openbmc_project.State.Host0 \
        /xyz/openbmc_project/state/host0 \
        xyz.openbmc_project.State.Host \
        RequestedHostTransition s \
        xyz.openbmc_project.State.Host.Transition.ForceWarmReboot
}

handle_all_power_ok() {
    local rc=0

    case "$Event" in
        RISING|INIT_HIGH)
            set_gpio PMBUS_MUX_SEL_C0 0 || rc=1
            set_gpio PMBUS_MUX_SEL_C1 0 || rc=1
            ;;
        FALLING|INIT_LOW)
            set_gpio PMBUS_MUX_SEL_C0 1 || rc=1
            set_gpio PMBUS_MUX_SEL_C1 1 || rc=1
            ;;
        *)
            echo "Error: unsupported wALL_POWER_OK_1 event: $Event"
            return 1
            ;;
    esac

    return "$rc"
}

restore_clear_rtc_bit() {
    set_gpio RTC_CLR 0
    i2cset -f -y "$BUS11" "$RTC_DEVICE" "$REG_OFFSET" "$CLEAR_BIT"
}

case "$GPIO_NET" in
    SOC_PORQ)
        trigger_host_reboot
        ;;
    SOC_RESETREQ)
        press_reset_button
        ;;
    wALL_POWER_OK_1)
        handle_all_power_ok
        ;;
    SOC_SYS_PWRDN_CPLD)
        trigger_host_poweroff
        ;;
    FM_CLEAR_RTC)
        restore_clear_rtc_bit
        ;;
    *)
        ;;
esac
