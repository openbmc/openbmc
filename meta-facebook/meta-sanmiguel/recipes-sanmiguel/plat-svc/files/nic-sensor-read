#!/bin/bash
# shellcheck source=meta-facebook/meta-sanmiguel/recipes-sanmiguel/plat-tools/files/platform-common-functions
source /usr/libexec/platform-common-functions

readonly EXT_SENSOR_SERVICE="xyz.openbmc_project.ExternalSensor"
readonly SENSOR_VAL_INTF="xyz.openbmc_project.Sensor.Value"
readonly STABILIZATION_DELAY=10
readonly POLL_INTERVAL=2

readonly HOST_ON=1
readonly HOST_OFF=0

NIC_INFO_LIST=(
    "31 IOB0_NIC0"
    "33 IOB0_NIC1"
    "41 IOB1_NIC0"
    "43 IOB1_NIC1"
    "51 IOB2_NIC0"
    "53 IOB2_NIC1"
    "61 IOB3_NIC0"
    "63 IOB3_NIC1"
)

declare -A NIC_SENSORS
declare -A NIC_NAMES
declare -A NIC_SENSOR_LIST_BUILT
LAST_HOST_READY="0"

# Bay C slot NIC "<eid> <name>", resolved at runtime from the card type:
# Clover CX9 "72 NS_NIC" or BlueField-4 "71 BF4"
NS_NIC_INFO=""


is_host_on() {
    local state
    state=$(busctl get-property \
        xyz.openbmc_project.State.Host \
        /xyz/openbmc_project/state/host0 \
        xyz.openbmc_project.State.Host CurrentHostState |
        cut -d'"' -f2)

    [[ "$state" == "xyz.openbmc_project.State.Host.HostState.Running" ]]
}

get_sensor_path() {
    local name="$1"

    case "$name" in
        *_TEMP_C) echo "/xyz/openbmc_project/sensors/temperature/$name" ;;
        *_PWR_W) echo "/xyz/openbmc_project/sensors/power/$name" ;;
        *) return 1 ;;
    esac
}

get_ns_nic_info() {
    local eid

    eid=$(plat_get_ns_nic_eid) || return 1
    case "$(plat_get_ns_nic_type)" in
        bf4) echo "$eid BF4" ;;
        *)   echo "$eid NS_NIC" ;;
    esac
}

update_sensor_val() {
    local path="$1"
    local val="$2"

    busctl set-property "$EXT_SENSOR_SERVICE" "$path" "$SENSOR_VAL_INTF" Value d "$val"
}

update_numeric_sensor_value() {
    local eid="$1"
    local sensor_id="${2%%:*}"
    local unit_modifier="${2##*:}"
    local sensor_name="$3"
    local val
    local path
    local out
    local op_state

    if ! out=$(pldmtool platform GetSensorReading -i "$sensor_id" -r 0 -m "$eid" 2>/dev/null); then
        echo "sensor read failed: eid=$eid id=$sensor_id name=$sensor_name"
        return 1
    fi

    # Check sensor operational state
    # If sensor is not enabled, set the sensor value to NaN (unavailable).
    # Otherwise, get the sensor value from presentReading.
    op_state=$(jq -r -e '.sensorOperationalState' <<< "$out" 2> /dev/null)
    if [ "$op_state" != "Sensor Enabled" ]; then
        val="nan"
    else
        if ! val=$(jq -e '.presentReading' <<< "$out" 2> /dev/null); then
            echo "sensor read failed: eid=$eid id=$sensor_id name=$sensor_name"
            return 1
        fi

        # Scale the raw reading by the unitModifier from the PDR.
        val=$(awk -v v="$val" -v m="$unit_modifier" 'BEGIN { printf "%.3f", v * 10 ^ m }')
    fi

    if path=$(get_sensor_path "$sensor_name"); then
        update_sensor_val "$path" "$val"
    fi
}

invalidate_all_sensors() {
    local eid
    local entry
    local entries
    local path

    # Only the sensors that have been polled hold a value to invalidate.
    for eid in "${!NIC_SENSORS[@]}"; do
        read -r -a entries <<< "${NIC_SENSORS[$eid]}"
        for entry in "${entries[@]}"; do
            if path=$(get_sensor_path "${NIC_NAMES[$eid]}_${entry%%:*}"); then
                update_sensor_val "$path" "nan"
            fi
        done
    done
}

handle_host_transition() {
    local current="$1"

    if [[ "$current" != "$LAST_HOST_READY" ]]; then
        if [[ "$current" == "1" ]]; then
            echo "Host ON, wait stabilization"
            sleep "$STABILIZATION_DELAY"
        else
            echo "Host OFF, invalidate all sensors..."
            invalidate_all_sensors
            for key in "${!NIC_SENSOR_LIST_BUILT[@]}"; do
                NIC_SENSOR_LIST_BUILT[$key]=0
            done
            NS_NIC_INFO=""
        fi
    fi

    LAST_HOST_READY="$current"
}

build_sensor_list() {
    local eid="$1"
    local -n out=$2
    local file="/tmp/pldm_pdr_${eid}.json"

    if ! timeout 3 pldmtool platform GetPDR -m "$eid" -a > "$file"; then
        return 1
    fi

    out=()

    # Each entry is "<name suffix>:<sensor id>:<unit modifier>". Sensors
    # missing from the PDRs are left out.
    local jq_out
    if ! jq_out=$(jq --arg eid "$eid" -r '
        [ .[] | select(.PDRType == "Numeric Sensor PDR") ] as $numeric |
        def sid(suffix; f): [ $numeric[] | select(f) | "\(suffix):\(.sensorID):\(.unitModifier)" ] | first // empty;
        if $eid == "71" then
            sid("NIC_PWR_W"; .sensorID == 4146),
            sid("NIC_TEMP_C"; .sensorID == 4396),
            sid("CPU_TEMP_C"; .sensorID == 7840),
            sid("SSD_TEMP_C"; .sensorID == 7841),
            sid("CPU_PWR_W"; .sensorID == 7728),
            sid("TOTAL_PWR_W"; .sensorID == 7984),
            sid("NIC_QSFP0_TEMP_C"; .sensorID == 4596),
            sid("NIC_QSFP1_TEMP_C"; .sensorID == 4597)
        else
            sid("PWR_W"; .sensorID >= 50 and .sensorID <= 59),
            sid("TEMP_C"; .sensorID >= 300 and .sensorID <= 399),
            ( if $eid == "72" then empty else sid("OSFP_TEMP_C"; .sensorID >= 500 and .sensorID <= 699) end )
        end
    ' "$file" 2>/dev/null); then
        echo "Error: Failed to parse PDR JSON for EID $eid" >&2
        return 1
    fi

    [[ -n "$jq_out" ]] && mapfile -t out <<< "$jq_out"
    return 0
}

# ------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------
while true; do
    sleep "$POLL_INTERVAL"

    host_ready=$(is_host_on && echo "$HOST_ON" || echo "$HOST_OFF")

    handle_host_transition "$host_ready"

    [[ "$host_ready" != "1" ]] && continue

    if [[ -z "$NS_NIC_INFO" ]]; then
        NS_NIC_INFO=$(get_ns_nic_info) || NS_NIC_INFO=""
    fi

    nic_list=("${NIC_INFO_LIST[@]}")
    [[ -n "$NS_NIC_INFO" ]] && nic_list+=("$NS_NIC_INFO")

    for nic_info in "${nic_list[@]}"; do
        read -r nic_eid nic_name <<< "$nic_info"

        if [[ "${NIC_SENSOR_LIST_BUILT[$nic_eid]:-0}" -ne 1 ]]; then
            echo "Fetching PDR and building sensor list for $nic_name (EID: $nic_eid)..."
            sensor_list=()
            if build_sensor_list "$nic_eid" sensor_list; then
                NIC_SENSORS["$nic_eid"]="${sensor_list[*]}"
                NIC_NAMES["$nic_eid"]="$nic_name"
                NIC_SENSOR_LIST_BUILT["$nic_eid"]=1
                echo "Available sensors for $nic_name: ${sensor_list[*]}"
            else
                echo "Failed to fetch PDR for $nic_name, retry on next poll."
                continue
            fi
        fi

        read -r -a sensor_entries <<< "${NIC_SENSORS[$nic_eid]}"

        for entry in "${sensor_entries[@]}"; do
            if ! is_host_on; then
                handle_host_transition "$HOST_OFF"
                break 2
            fi

            sensor_name="${nic_name}_${entry%%:*}"
            update_numeric_sensor_value "$nic_eid" "${entry#*:}" "$sensor_name"
        done
    done
done
