#!/bin/bash
if [ -z "$1" ]; then
    echo "Usage: $0 <i2c-dev>" >&2
    exit 1
fi

I2C_DEV="$1"
readonly MAX_VOLT=10
readonly MIN_VOLT=2
readonly MAX_FLOWRATE=333               # UNIT: LPM
readonly DEFAULT_FLOWRATE=150           # UNIT: LPM
readonly VALVE_CONFIG_FILE="/var/lib/valvemonitor/valve-config.json"
readonly MAX_ATTEMPTS=10
readonly RETRY_INTERVAL=0.5

ADDR=${I2C_DEV##*-}

flowrate_to_volt() {
    local flowrate="$1"
    awk -v flowrate="$flowrate" \
        -v max_volt="$MAX_VOLT" \
        -v min_volt="$MIN_VOLT" \
        -v max_flowrate="$MAX_FLOWRATE" \
        'BEGIN {print (flowrate/max_flowrate)*(max_volt-min_volt)+min_volt}'
}

declare -A ADDR_MAP=(
    ["000c"]="SupplyValve2_2"
    ["000e"]="SupplyValve2_3"
    ["000f"]="SupplyValve2_1"
)

FLOWRATE="$DEFAULT_FLOWRATE"
CONFIG_SOURCE="default"

VALVE_NAME="${ADDR_MAP[$ADDR]}"
if [ -z "$VALVE_NAME" ]; then
    echo "[$I2C_DEV] Bus addr '$ADDR' not found in mapping table, using default flowrate: ${DEFAULT_FLOWRATE} LPM" >&2
elif [ ! -f "$VALVE_CONFIG_FILE" ]; then
    echo "[$I2C_DEV] Valve config file '$VALVE_CONFIG_FILE' not found, using default flowrate: ${DEFAULT_FLOWRATE} LPM" >&2
else
    _flowrate=$(jq --arg name "$VALVE_NAME" \
            '.Valves[] | select(.Name == $name) | .FlowRate' \
        "$VALVE_CONFIG_FILE")
    if [[ "$_flowrate" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        if awk -v flow="$_flowrate" -v max="$MAX_FLOWRATE" \
            'BEGIN { exit !(flow >= 0 && flow <= max) }'; then
            FLOWRATE="$_flowrate"
            CONFIG_SOURCE="config"
        else
            echo "[$I2C_DEV] FlowRate '$_flowrate' out of range (0..$MAX_FLOWRATE) for '$VALVE_NAME', using default flowrate: ${DEFAULT_FLOWRATE} LPM" >&2
        fi
    else
        echo "[$I2C_DEV] Unable to read a single valid FlowRate for '$VALVE_NAME' from '$VALVE_CONFIG_FILE', using default flowrate: ${DEFAULT_FLOWRATE} LPM" >&2
    fi
fi
VOLT=$(flowrate_to_volt "$FLOWRATE")
echo "[$I2C_DEV] source=$CONFIG_SOURCE valve=$VALVE_NAME flowrate=$FLOWRATE LPM target_volt=$VOLT"

dac_volt_set() {
    local dev="$1" volt="$2"
    local iio raw

    if ! iio=$(ls -d /sys/bus/i2c/devices/"$dev"/iio:device* 2>/dev/null); then
        echo "[$dev] IIO device not ready" >&2
        return 1
    fi

    raw=$(awk -v r="$volt" 'BEGIN { printf "%d", (r-1.05)/0.008826979 }')
    [ "$raw" -lt 0 ] && raw=0
    echo "[$dev] volt=$volt raw=$raw"

    if ! echo "$raw" > "$iio/out_voltage0_raw"; then
        echo "[$dev] Write failed: $iio/out_voltage0_raw value=$raw" >&2
        return 1
    fi

    if ! echo 0 > "$iio/out_voltage0_powerdown"; then
        echo "[$dev] Write failed: $iio/out_voltage0_powerdown value=0" >&2
        return 1
    fi

    return 0
}

for ((attempt = 1; attempt <= MAX_ATTEMPTS; attempt++)); do
    echo "[$I2C_DEV] DAC programming attempt=$attempt/$MAX_ATTEMPTS"
    if dac_volt_set "$I2C_DEV" "$VOLT"; then
        echo "[$I2C_DEV] DAC programming completed attempt=$attempt"
        exit 0
    fi
    if ((attempt < MAX_ATTEMPTS)); then
        sleep "$RETRY_INTERVAL"
    fi
done

echo "[$I2C_DEV] DAC programming failed after $MAX_ATTEMPTS attempts" >&2
exit 1
