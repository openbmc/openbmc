#!/bin/bash

# Ventura2 Sled Power Cycle

# Stop writes to rwfs before BMC power is removed.
# Lazy umount alone does not stop writes through the overlays.
rwfs-quiesce() {
    timeout 10 systemctl stop syslog.socket rsyslog.service
    sync
    for m in /mnt/data /home /var /etc; do
        umount --lazy "$m" 2>/dev/null
    done
    if ! /usr/libexec/phosphor-static-norootfs-init/umount-filesystem; then
        echo "Failed to detach /run/mnt-persist"
    else
        echo "Succeeded to detach /run/mnt-persist"
    fi
    sync
    sleep 2
}

rmc-hsc-power-cycle() {
    # LTC4287 MFR_REBOOT_CONTROL (FDh) Read/Write
    # [3]:
    #       REBOOT 0 Write a 1 to reboot.
    # [2:0]
    #       RBT_DL 100 Configures Auto-Reboot turn-on Delay (tDL(RBT)) after the REBOOT bit is set to 1
    #       RBT_DL[2:0] DELAY
    #       000 0.580 s
    #       001 1.16 s
    #       010 2.32 s
    #       011 4.64 s
    #       100 9.28 s
    #       101 18.6 s
    #       110 37.1 s
    #       111 74.2 s
    ret1=$(i2cget -y -f 10 0x44)
    ret2=$(i2cget -y -f 10 0x24)

    if [[ "$ret1" =~ ^0x[0-9A-Fa-f]+$ ]]; then
        echo "RMC Main Source AC"
        rwfs-quiesce
        i2cset -y -f 10 0x44 0xfd 0x00
        i2cset -y -f 10 0x44 0xfd 0x0b
    elif [[ "$ret2" =~ ^0x[0-9A-Fa-f]+$ ]]; then
        echo "RMC Second Source AC"
        rwfs-quiesce
        i2ctransfer -f -y 10 w1@0x24 0xec
    fi

    return 0

}

# RMC Sled Power Cycle
if [ "$1" == 0 ]
then
    echo "Staring RMC Sled Power Cycle"
    rmc-hsc-power-cycle
else
    echo "Invalid RMC Cycle"
    exit 1
fi
