#!/bin/bash

# shellcheck source=meta-facebook/recipes-fb/obmc_functions/files/fb-common-functions
source /usr/libexec/fb-common-functions

help_msg="
Usage: smc-event-logger <event> <gpio_name>
<event> is the smc event to log,
e.g. assert / deassert.

<gpio_name> is defined in json file,
e.g. AALC_RPU_READY
"

gpio_name="$2"
stash_file="/var/lib/phosphor-gpio-monitor/${gpio_name}.log_entry"

# Present pins of the RPU links, active-low.
RPU0_PRSNT="IT_GEAR_RPU_LINK_PRSNT_N_R"
RPU0_SPARE_PRSNT="IT_GEAR_RPU_LINK_PRSNT_SPARE_N_"
RPU1_PRSNT="IT_GEAR_RPU_2_LINK_PRSNT_N_R"
RPU1_SPARE_PRSNT="IT_GEAR_RPU_2_LINK_PRSNT_SPARE_"
ALL_RPU_PRSNT=("$RPU0_PRSNT" "$RPU0_SPARE_PRSNT" "$RPU1_PRSNT" "$RPU1_SPARE_PRSNT")

# A pin that cannot be read counts as present, so that an event is logged
# rather than missed.
is_prsnt() {
    [ "$(get_gpio_val_by_name "$1")" != "1" ]
}

is_all_rpu_prsnt() {
    local pin
    for pin in "${ALL_RPU_PRSNT[@]}"; do
        is_prsnt "$pin" || return 1
    done
    return 0
}

is_any_rpu_prsnt() {
    local pin
    for pin in "${ALL_RPU_PRSNT[@]}"; do
        is_prsnt "$pin" && return 0
    done
    return 1
}

# Whether the RPU links required for <gpio_name> to fail are installed, so
# that signals of absent links are ignored.
# The CPLD only deasserts a present pin after the RPU ready and IT stop pump
# signals of that link have changed, so the pins can be checked right at the
# assert edge.
is_rpu_link_ok() {
    case "$1" in
    RPU_READY_PLD_R)
        is_prsnt "$RPU0_PRSNT"
        ;;
    RPU_READY_SPARE_PLD_R)
        is_prsnt "$RPU0_SPARE_PRSNT"
        ;;
    RPU_2_READY_PLD_R)
        is_prsnt "$RPU1_PRSNT"
        ;;
    RPU_2_READY_SPARE_PLD_R)
        is_prsnt "$RPU1_SPARE_PRSNT"
        ;;
    AALC_RPU_READY)
        # Only goes high with all RPU links installed.
        is_all_rpu_prsnt
        ;;
    IT_STOP_PUMP_*)
        # Asserted together for all pumps when any link drops.
        is_any_rpu_prsnt
        ;;
    *)
        return 0
        ;;
    esac
}

get_failure_type() {
    if [ "$1" = "AALC_RPU_READY" ]; then
        echo "Ready Timed-out"
    elif [ "$1" = "RPU_READY_PLD_R" ]; then
        echo "Ready Timed-out"
    elif [ "$1" = "RPU_READY_SPARE_PLD_R" ]; then
        echo "Ready Timed-out"
    elif [ "$1" = "RPU_2_READY_PLD_R" ]; then
        echo "Ready Timed-out"
    elif [ "$1" = "RPU_2_READY_SPARE_PLD_R" ]; then
        echo "Ready Timed-out"
    elif [ "$1" = "IT_STOP_PUMP_R_CPLD" ]; then
        echo "Undefined"
    elif [ "$1" = "IT_STOP_PUMP_SPARE_R_CPLD" ]; then
        echo "Undefined"
    elif [ "$1" = "IT_STOP_PUMP_2_R_CPLD" ]; then
        echo "Undefined"
    elif [ "$1" = "IT_STOP_PUMP_SPARE_2_R_CPLD" ]; then
        echo "Undefined"
    else
        echo "Undefined"
    fi
}

get_identifier() {
    if [ "$1" = "AALC_RPU_READY" ]; then
        echo "AALC RPU Ready"
    elif [ "$1" = "RPU_READY_PLD_R" ]; then
        echo "RPU0 Ready"
    elif [ "$1" = "RPU_READY_SPARE_PLD_R" ]; then
        echo "RPU0 Ready Spare"
    elif [ "$1" = "RPU_2_READY_PLD_R" ]; then
        echo "RPU1 Ready"
    elif [ "$1" = "RPU_2_READY_SPARE_PLD_R" ]; then
        echo "RPU1 Ready Spare"
    elif [ "$1" = "IT_STOP_PUMP_R_CPLD" ]; then
        echo "IT Stop Pump0"
    elif [ "$1" = "IT_STOP_PUMP_SPARE_R_CPLD" ]; then
        echo "IT Stop Pump0 Spare"
    elif [ "$1" = "IT_STOP_PUMP_2_R_CPLD" ]; then
        echo "IT Stop Pump1"
    elif [ "$1" = "IT_STOP_PUMP_SPARE_2_R_CPLD" ]; then
        echo "IT Stop Pump1 Spare"
    else
        echo "$1"
    fi
}

case "$1" in
"-h")
    echo "$help_msg"
    ;;

"assert")
    if ! is_rpu_link_ok "$gpio_name"; then
        exit 0
    fi

    log-create "xyz.openbmc_project.State.SMC.SMCFailed" --json \
        "{\"IDENTIFIER\": \"$(get_identifier "$gpio_name")\", \"FAILURE_TYPE\": \"$(get_failure_type "$gpio_name")\"}" \
        >"${stash_file}"
    ;;

"deassert")
    if [ -s "${stash_file}" ]; then
        log-resolve -p "$(<"${stash_file}")"
        rm "${stash_file}"
        log-create "xyz.openbmc_project.State.SMC.SMCRestored" --json \
            "{\"IDENTIFIER\": \"$(get_identifier "$gpio_name")\"}"
    fi

    ;;
esac

exit 0
