    set_gpio EN_P12V_U2_24_R1 0
    set_gpio EN_P12V_U2_25_R1 0
    set_gpio EN_P12V_U2_26_R1 0

    # Rio Grande ADC128D818 mode setting
    # RIO_GRANDE_ADC0
    i2cset -yf 69 0x2d 0x00 0x00
    i2cset -yf 69 0x2d 0x0b 0x02
    # RIO_GRANDE_ADC1
    i2cset -yf 69 0x2e 0x00 0x00
    i2cset -yf 69 0x2e 0x0b 0x02
    # RIO_GRANDE_ADC2
    i2cset -yf 70 0x2f 0x00 0x00
    i2cset -yf 70 0x2f 0x0b 0x02
    # RIO_GRANDE_ADC3
    i2cset -yf 70 0x35 0x00 0x00
    i2cset -yf 70 0x35 0x0b 0x02


    # 40-bit IOE mask settings
    i2cset -yf 15 0x26 0x20 0x00
    i2cset -yf 15 0x26 0x22 0x00
    i2cset -yf 15 0x26 0x23 0x00
    i2cset -yf 15 0x26 0x24 0x00

    i2cset -yf 12 0x26 0x20 0x00
    i2cset -yf 12 0x26 0x22 0x00
    i2cset -yf 12 0x26 0x23 0x00
    i2cset -yf 12 0x26 0x24 0x80

    i2cset -yf 2 0x26 0x20 0x00
    i2cset -yf 2 0x26 0x22 0x00
    i2cset -yf 2 0x26 0x23 0x00
    i2cset -yf 2 0x26 0x24 0x00

    hsc_init(){
        local bus=$1
        local addr=$2

        # Get manufacturer ID from HSC
        mfr_id=""
        for b in $(i2cget -yf "$bus" "$addr" 0x99 s); do
            mfr_id=$(printf '%02X' "$b")$mfr_id
        done
        mfr_id="0x$mfr_id"

        # MPS config
        if [ "$mfr_id" = "0x4D5053" ]; then
            efuse_cfg=$(i2cget -yf "$bus" "$addr" 0xC4 w)
            cfg=$(( (efuse_cfg | (1 << 8)) & 0xFFFF ))
            i2cset -yf "$bus" "$addr" 0xC4 "$cfg" w
        # TI config
        elif [ "$mfr_id" = "0x4954" ]; then
            alert_mask=$(i2cget -yf "$bus" "$addr" 0xDB w)
            cfg=$(( (alert_mask | (1 << 1)) & 0xFFFF ))
            i2cset -yf "$bus" "$addr" 0xDB "$cfg" w
        else
            echo "Unknown manufacturer ID: $mfr_id for address $addr"
        fi
    }

    # HSC on bus 6
    for addr in 0x42 0x43 0x44 0x45 0x48; do
        hsc_init 6 "$addr"
    done

    # HSC on bus 8
    hsc_init 8 0x47
}

