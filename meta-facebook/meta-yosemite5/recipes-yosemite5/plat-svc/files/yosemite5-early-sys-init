set_product_versions_to_mb_cpld()
{
    printf "Setting board product version to MB CPLD\n"

    local BUS="11"
    local ADDR="0x0f"
    declare -A REGS=( ["17"]=0x88 ["18"]=0x88 )

    local BOARD_CONFIGS=(
        "E1_S:17:16"
        "SCM:17:1"
        "Victoria_Falls:18:16"
        "Maple_Falls:18:1"
    )

    for CONFIG in "${BOARD_CONFIGS[@]}"; do
        local BOARD REG MULT
        IFS=":" read -r BOARD REG MULT <<< "$CONFIG"

        local FRU_NAME
        if ! FRU_NAME=$(find_fru_name "$BOARD"); then
            continue
        fi

        local VERSION
        VERSION=$(get_product_version "$FRU_NAME")
        if [ "$VERSION" = "Unknown" ]; then
            continue
        fi

        local STAGE_VAL
        case "$VERSION" in
            EVT)      STAGE_VAL=0 ;;
            DVT|DVT1) STAGE_VAL=1 ;;
            DVT2)     STAGE_VAL=2 ;;
            DVT3)     STAGE_VAL=3 ;;
            PVT)      STAGE_VAL=4 ;;
            MP)       STAGE_VAL=5 ;;
            *)        continue ;;
        esac

        local MASK=$(( 0x0F * MULT ))
        local VAL=$(( STAGE_VAL * MULT ))
        REGS["$REG"]=$(( (REGS["$REG"] & ~MASK) | VAL ))

        printf "Found %s version: %s\n" "$FRU_NAME" "$VERSION"
    done

    for REG in "${!REGS[@]}"; do
        local VAL_HEX
        VAL_HEX=$(printf "0x%02x" "${REGS[$REG]}")

        if ! i2cset -y "$BUS" "$ADDR" "0x$REG" "$VAL_HEX" 2>/dev/null; then
            printf "MB CPLD Reg 0x%s: Write failed\n" "$REG"
            continue
        fi

        local READ_VAL
        READ_VAL=$(i2cget -y "$BUS" "$ADDR" "0x$REG" 2>/dev/null)

        if [ -z "$READ_VAL" ]; then
            printf "MB CPLD Reg 0x%s: Read back failed\n" "$REG"
        elif [ "$((READ_VAL))" -ne "$((VAL_HEX))" ]; then
            printf "MB CPLD  Reg 0x%s: Mismatch (W:%s R:%s)\n" \
                "$REG" "$VAL_HEX" "$READ_VAL"
        else
            printf "MB CPLD Reg 0x%s: Updated to %s\n" "$REG" "$VAL_HEX"
        fi
    done
}

ti_hsc_init()
{
    local BOARD="1KW_paddle_BD"
    local FRU_NAME
    local SOURCE

    if ! FRU_NAME=$(find_fru_name "$BOARD"); then
        echo "Can't find ${BOARD} FRU."
        return
    fi

    SOURCE=$(get_product_source "$FRU_NAME")
    if [ "$SOURCE" = "Unknown" ]; then
        echo "Unknown Paddle HSC source."
        return
    fi

    if [ "$SOURCE" = "HSC-TIC" ]; then
        local BUS="8"
        local ADDR="0x47"
        local REG_WRITE_PROTECT="0xF8"
        local REG_OC_TIMER="0xE6"
        local REG_ALERT_MASK="0xDB"
        local WRITE_PROTECT_VAL="0xA2"
        local OC_TIMER_VAL="0x5c"
        local ALERT_MASK_VAL="0x0102"
        local READ_VAL

        echo "Initializing TIC HSC"
        i2cset -y -f "$BUS" "$ADDR" "$REG_WRITE_PROTECT" "$WRITE_PROTECT_VAL" || echo "Failed to unlock write protection"
        i2cset -y -f "$BUS" "$ADDR" "$REG_OC_TIMER" "$OC_TIMER_VAL" || echo "Failed to set OC timer"
        i2cset -y -f "$BUS" "$ADDR" "$REG_ALERT_MASK" "$ALERT_MASK_VAL" w || echo "Failed to set alert mask"

        READ_VAL=$(i2cget -y -f "$BUS" "$ADDR" "$REG_OC_TIMER" 2>/dev/null)
        if [ -z "$READ_VAL" ]; then
            echo "Failed to read OC timer"
        elif [ "$READ_VAL" == "$OC_TIMER_VAL" ]; then
            echo "OC timer set to $OC_TIMER_VAL"
        else
            echo "OC timer mismatch (W:$OC_TIMER_VAL R:$READ_VAL)"
        fi

        READ_VAL=""

        READ_VAL=$(i2cget -y -f "$BUS" "$ADDR" "$REG_ALERT_MASK" w 2>/dev/null)
        if [ -z "$READ_VAL" ]; then
            echo "Failed to read alert mask"
        elif [ "$READ_VAL" == "$ALERT_MASK_VAL" ]; then
            echo "Alert mask set to $ALERT_MASK_VAL"
        else
            echo "Alert mask mismatch (W:$ALERT_MASK_VAL R:$READ_VAL)"
        fi
    fi
}

T22_init(){
