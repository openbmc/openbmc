    BOOTSTATUS_FILE="/sys/class/watchdog/watchdog0/bootstatus"

    # Check bmc last boot status, if not power-on-reset, skip init
    if [ -f "$BOOTSTATUS_FILE" ]; then
        bootstatus=$(cat "$BOOTSTATUS_FILE" 2>/dev/null)
    else
        echo "$BOOTSTATUS_FILE not found, defaulting to 0 "
        bootstatus=0
    fi
    if [ "$bootstatus" != "0" ]; then
        echo "BMC not Power-On-Reset (bootstatus=$bootstatus), skip init"
        exit 0
    fi

    # set initial value for IOEXP GPIO output pins
    # 3kw board
