#!/bin/bash

# shellcheck source=meta-facebook/recipes-fb/obmc_functions/files/fb-common-functions
source /usr/libexec/fb-common-functions

# SKU is consumed by scripts that source this file.
# shellcheck disable=SC2034
SKU_T2=0
# shellcheck disable=SC2034
SKU_T11=1
# shellcheck disable=SC2034
SKU_T1=2
# shellcheck disable=SC2034
SKU_T22=3

FRU_SVC="xyz.openbmc_project.FruDevice"
FRU_ROOT="/xyz/openbmc_project/FruDevice"

find_fru_name()
{
    local KEYWORD="$1"
    local FRU_PATH

    if [ -z "$KEYWORD" ]; then
        echo "find_fru_name: no keyword provided" >&2
        return 1
    fi

    FRU_PATH=$(busctl tree "$FRU_SVC" --list --timeout=10s 2>/dev/null |
        grep -i "$KEYWORD" | head -n 1)

    if [ -z "$FRU_PATH" ]; then
        echo "find_fru_name: no FRU found for $KEYWORD" >&2
        return 1
    fi

    basename "$FRU_PATH"
}

get_product_version()
{
    local FRU_NAME="$1"
    local OUTPUT
    local VERSION
    local OBJ_PATH="$FRU_ROOT/$FRU_NAME"

    if [ -z "$FRU_NAME" ]; then
        echo "get_product_version: no name provided" >&2
        return 1
    fi

    if ! OUTPUT=$(busctl get-property --timeout=10s \
        "$FRU_SVC" "$OBJ_PATH" "$FRU_SVC" PRODUCT_VERSION 2>/dev/null); then
        echo "Unknown"
        return 1
    fi

    VERSION=$(echo "$OUTPUT" | cut -d'"' -f2)

    if [ -z "$VERSION" ] || [ "$VERSION" = "$OUTPUT" ]; then
        echo "get_product_version: parse error for $FRU_NAME" >&2
        echo "Unknown"
        return 1
    fi

    echo "$VERSION"
}

get_product_source()
{
    local FRU_NAME="$1"
    local OUTPUT
    local SOURCE
    local OBJ_PATH="$FRU_ROOT/$FRU_NAME"

    if [ -z "$FRU_NAME" ]; then
        echo "get_product_source: no name provided" >&2
        return 1
    fi

    if ! OUTPUT=$(busctl get-property --timeout=10s \
        "$FRU_SVC" "$OBJ_PATH" "$FRU_SVC" BOARD_INFO_AM4 2>/dev/null); then
        echo "Unknown"
        return 1
    fi

    SOURCE=$(echo "$OUTPUT" | cut -d'"' -f2)

    if [ -z "$SOURCE" ] || [ "$SOURCE" = "$OUTPUT" ]; then
        echo "get_product_source: parse error for $FRU_NAME" >&2
        echo "Unknown"
        return 1
    fi

    echo "$SOURCE"
}

i2ctransfer_retry() {
    local max_retries=5
    local i

    for ((i=0; i<max_retries; i++)); do
        if i2ctransfer "$@"; then
            return 0
        fi

        sleep 1
    done

    return 1
}

get_data_from_pdb_cpld() {
    local bus=8
    local addr=0x0f
    local reg_value

    if ! reg_value=$(i2ctransfer_retry -fy ${bus} w1@${addr} "${1}" r1 2>/dev/null); then
        echo "Error: I2C transfer failed, bus=${bus}, addr=${addr}, reg=${1}" >&2
        return 1
    fi

    echo "${reg_value}"
    return 0
}

# Get SKU from PDB CPLD.
# [3:0]:
#   0x0 --> T2
#   0x1 --> T11
#   0x2 --> T1
#   0x3 --> T22
get_sku() {
    local reg=0x12
    local reg_value
    local sku

    if ! reg_value=$(get_data_from_pdb_cpld ${reg}); then
        return 1
    fi

    sku=$((reg_value & 0x0f))
    echo "${sku}"
    return 0
}
