#!/bin/bash

# shellcheck source=meta-facebook/recipes-fb/obmc_functions/files/fb-common-functions
source /usr/libexec/fb-common-functions

# Power Good Status
power_status() {
    if [ "$(get_gpio "PWRGD_CPU_PWROK_1")" = "1" ]; then
        echo "on"
    else
        echo "off"
    fi
}

gpio_pulse() {
    local gpio=$1 assert=$2 duration=$3
    local deassert=$(( 1 - assert ))
    trap 'trap - INT TERM; echo "gpio_pulse($gpio): interrupted, restoring to $deassert" | systemd-cat -t power-cmd -p warning; set_gpio "$gpio" "$deassert"; exit 1' INT TERM
    set_gpio "$gpio" "$assert"
    sleep "$duration"
    set_gpio "$gpio" "$deassert"
    sleep 1
    trap - INT TERM
}

# Force DC off
force_power_off() {
    if [ "$(power_status)" == "on" ]; then
        gpio_pulse SYS_BMC_PWRBTN_N 0 5

        for _ in {1..10}; do
            sleep 1
            if [ "$(power_status)" == "off" ]; then
                return 0
            fi
        done
        return 1
    fi
    return 0
}

# Graceful DC off
graceful_power_off() {
    if [ "$(power_status)" == "on" ]; then
        gpio_pulse SYS_BMC_PWRBTN_N 0 1

        for _ in {1..180}; do
            sleep 1
            if [ "$(power_status)" == "off" ]; then
                return 0
            fi
        done
        return 1
    fi
    return 0
}

# DC on
power_on() {
    if [ "$(power_status)" == "off" ]; then
        gpio_pulse SYS_BMC_PWRBTN_N 0 1

        for _ in {1..10}; do
            sleep 1
            if [ "$(power_status)" == "on" ]; then
                return 0
            fi
        done
        return 1
    fi
    return 0
}

# Host reset
power_reset() {
    gpio_pulse SGPIO_RSTBTN_OUT 1 1
    return 0
}

is_service_busy() {
    local unit path active sub
    for unit in "$@"; do
        path="/org/freedesktop/systemd1/unit/${unit//-/_2d}"
        path="${path//@/_40}"
        path="${path//./_2e}"

        active=$(busctl get-property org.freedesktop.systemd1 "$path" org.freedesktop.systemd1.Unit ActiveState 2>/dev/null)
        active="${active#s \"}"
        active="${active%\"}"
        if [ -z "$active" ] || [ "$active" = "inactive" ] || [ "$active" = "failed" ]; then
            continue
        fi

        sub=$(busctl get-property org.freedesktop.systemd1 "$path" org.freedesktop.systemd1.Unit SubState 2>/dev/null)
        sub="${sub#s \"}"
        sub="${sub%\"}"
        if [ "$sub" != "exited" ]; then
            return 0
        fi
    done
    return 1
}

HOST_STATE_SVC="xyz.openbmc_project.State.Host0"
HOST_STATE_OBJ="/xyz/openbmc_project/state/host0"
HOST_STATE_INTF="xyz.openbmc_project.State.Host"

get_host_prop() {
    local val
    val=$(busctl get-property "$HOST_STATE_SVC" "$HOST_STATE_OBJ" "$HOST_STATE_INTF" "$1" 2>/dev/null)
    val="${val#s \"}"
    val="${val%\"}"
    echo "$val"
}

set_host_prop() {
    busctl set-property "$HOST_STATE_SVC" "$HOST_STATE_OBJ" "$HOST_STATE_INTF" "$1" s "$2"
}
