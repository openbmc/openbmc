#!/bin/sh

# Setup Endpoint for NICs, using devmem to read GPIO value since
# the gpio pin is occupied by gpio-monitor, read the value from
# gpioget is not possible.

# shellcheck source=meta-facebook/meta-yosemite4/recipes-networking/mctp/files/nic-gpio-addrs
. /usr/libexec/mctp/nic-gpio-addrs

setup_nic() {
	slot=$1
	address=$2
	mask=$3

	# A failed read must not be interpreted as an active-low presence signal.
	gpio_val=$(devmem "$address" "$WIDTH") || return 1
	if [ $((gpio_val & "$mask")) -eq 0 ]; then
		systemctl start "setup-nic-endpoint-slot@${slot}.service"
	fi
}

setup_nic 0 "$PRSNT_NIC0" "$BITMASK_NIC0"
setup_nic 1 "$PRSNT_NIC1" "$BITMASK_NIC1"
setup_nic 2 "$PRSNT_NIC2" "$BITMASK_NIC2"
setup_nic 3 "$PRSNT_NIC3" "$BITMASK_NIC3"
