#!/bin/bash

get_gpio()
{
    local NET_NAME=$1
    local RET_VAL

    mapfile -t -d " " GPIO_INFO < <(gpiofind "$NET_NAME")
    if [ "${#GPIO_INFO[@]}" -ne 2 ]; then
        echo "get_gpio: can not find gpio, $NET_NAME" >&2
        return 1
    fi
    for _ in {1..10}
    do
        if ! RET_VAL=$(gpioget "${GPIO_INFO[0]}" "${GPIO_INFO[1]%$'\n'}") ; then
            usleep 10000
            continue
        else
            echo "${RET_VAL}"
            return 0
        fi
    done

    echo "get_gpio: get ${NET_NAME} failed" >&2
    return 1
}

set_gpio()
{
    local NET_NAME=$1
    local OUT_VAL=$2
    mapfile -t -d " " GPIO_INFO < <(gpiofind "$NET_NAME")
    if [ "${#GPIO_INFO[@]}" -ne 2 ]; then
        echo "set_gpio: can not find gpio, $NET_NAME"
        return 1
    fi

    echo -n "set_gpio: set $NET_NAME = $OUT_VAL"
    if ! gpioset "${GPIO_INFO[0]}" "${GPIO_INFO[1]%$'\n'}"="$OUT_VAL"; then
        echo " failed"
        return 1
    fi

    echo " success"
    return 0
}

bind_i2c_device()
{
    local DRIVER_NAME="$1"
    local DEV_BUS_ADDR="$2"
    local DRIVER_DIR_PATH="/sys/bus/i2c/drivers/${DRIVER_NAME}"
    local DRIVER_BIND_PATH="${DRIVER_DIR_PATH}/bind"
    local MAX_RETRIES=1
    local RETRY=0

    if [ -n "$3" ]; then
        MAX_RETRIES="$3"
    fi

    if [ -L "${DRIVER_DIR_PATH}/${DEV_BUS_ADDR}" ]; then
        return 0
    fi

    while [ "$RETRY" -lt "$MAX_RETRIES" ]
    do
        if echo "${DEV_BUS_ADDR}" > "${DRIVER_BIND_PATH}"; then
            echo "bind_i2c_device: $DRIVER_NAME, $DEV_BUS_ADDR successful"
            return 0
        fi

        RETRY=$((RETRY + 1))
        echo "bind_i2c_device: $DRIVER_NAME, $DEV_BUS_ADDR failed"
        usleep 50000
    done

    return 1
}

get_gpio_val_from_debugfs()
{
    local CHIP=$1
    local LINE=$2
    local DEBUGFS_GPIO="${DEBUGFS_GPIO:-/sys/kernel/debug/gpio}"

    [ -n "$CHIP" ] && [ -n "$LINE" ] || return 1
    [ -r "$DEBUGFS_GPIO" ] || return 1
    [[ $CHIP =~ ^[0-9]+$ ]] && CHIP="gpiochip$CHIP"

    awk -v chip="${CHIP}:" -v line="$LINE" '
        /^gpiochip[0-9]+:/ {
            if (insec) exit
            insec = ($1 == chip)
            if (insec) {
                base = 0
                if (match($0, /GPIOs [0-9]+-/))
                    base = substr($0, RSTART + 6, RLENGTH - 7)
                target = "gpio-" (base + line)
            }
            next
        }
        insec && $1 == target {
            sub(/^[^)]*\)/, "")
            for (i = 1; i <= NF; i++) {
                if ($i == "hi") { print 1; found = 1; exit }
                if ($i == "lo") { print 0; found = 1; exit }
            }
            exit
        }
        END { exit (found ? 0 : 1) }
    ' "$DEBUGFS_GPIO"
}

get_gpio_val_by_name()
{
    local NET_NAME=$1
    local CHIP LINE RET_VAL

    if ! read -r CHIP LINE < <(gpiofind "$NET_NAME") || [ -z "$LINE" ]; then
        echo "get_gpio_val_by_name: can not find gpio, $NET_NAME" >&2
        return 1
    fi

    for _ in {1..10}; do
        if RET_VAL=$(gpioget "$CHIP" "$LINE" 2>/dev/null); then
            echo "$RET_VAL"
            return 0
        fi
        if RET_VAL=$(get_gpio_val_from_debugfs "$CHIP" "$LINE"); then
            echo "$RET_VAL"
            return 0
        fi
        usleep 10000
    done

    echo "get_gpio_val_by_name: get $NET_NAME failed (chip=$CHIP line=$LINE)" >&2
    return 1
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    CMD=$1
    shift
    case "$CMD" in
        get_gpio)
            get_gpio "$@"
            ;;
        set_gpio)
            set_gpio "$@"
            ;;
        bind_i2c_device)
            bind_i2c_device "$@"
            ;;
        get_gpio_val_by_name)
            get_gpio_val_by_name "$@"
            ;;
        *)
            echo "Usage: $0 {get_gpio|set_gpio|bind_i2c_device} args..."
            exit 1
            ;;
    esac
fi
