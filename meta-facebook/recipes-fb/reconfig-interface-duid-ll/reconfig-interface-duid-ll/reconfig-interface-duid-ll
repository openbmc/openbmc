#!/bin/bash

INTF_NAME="$1"
DHCPv6_SETTING_ADD="IAID=0\nDUIDType=link-layer"

# Use dropin to set DUIDType. systemd-networkd merges it into
# 00-bmc-${INTF_NAME}.network whenever that file is loaded, so it can be
# created before phosphor-networkd writes the .network file. No reload is
# needed: this runs before systemd-networkd starts, and the reload that
# phosphor-networkd issues after writing the .network file picks it up.
DROPIN_DIR="/run/systemd/network/00-bmc-${INTF_NAME}.network.d"
DROPIN_FILE="${DROPIN_DIR}/duid-ll.conf"

if [ ! -f "$DROPIN_FILE" ] || ! grep -q "^DUIDType=" "$DROPIN_FILE"; then
    mkdir -p "$DROPIN_DIR"
    # Write DUIDType setting to dropin file
    printf "[DHCPv6]\n%b\n" "$DHCPv6_SETTING_ADD" > "$DROPIN_FILE"
    echo "Added DUID-LL dropin for ${INTF_NAME}."
else
    echo "DUID-LL dropin for ${INTF_NAME} already exists. Exiting..."
fi

exit 0
