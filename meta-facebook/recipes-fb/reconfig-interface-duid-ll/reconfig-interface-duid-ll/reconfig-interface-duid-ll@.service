[Unit]
Description=Reconfig %i to get the IPv6 LL
DefaultDependencies=no
Before=systemd-networkd.service xyz.openbmc_project.Network.service

[Service]
ExecStart=/usr/libexec/reconfig-interface-duid-ll %i
SyslogIdentifier=reconfig-interface-duid-ll-%i
Type=oneshot

[Install]
WantedBy=multi-user.target systemd-networkd.service
