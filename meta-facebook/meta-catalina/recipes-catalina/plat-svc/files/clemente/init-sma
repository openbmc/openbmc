#!/bin/bash
# shellcheck source=meta-facebook/recipes-fb/obmc_functions/files/fb-common-functions
# shellcheck disable=SC2317

source /usr/libexec/fb-common-functions

MAX_RETRY=5
declare -A cx_eids

check_and_reset_usb_hub() {
    # check mcu1u2u2 for IOB0 SMA
    if ! mctp link show mcu1u2u2; then
        echo "IOB0 SMA USB device is not exist. Resetting the hub using GPIO."
        set_gpio "USB2_HUB_RST_L-O" 0
        sleep 1
        set_gpio "USB2_HUB_RST_L-O" 1
        sleep 1
    fi

    # check mcu1u2u7u2 for IOB0 SMA
    if ! mctp link show mcu1u2u7u2; then
        echo "IOB1 SMA USB device is not exist. Resetting the hub using GPIO."
        set_gpio "SEC_USB2_HUB_RST_L" 0
        sleep 1
        set_gpio "SEC_USB2_HUB_RST_L" 1
        sleep 1
    fi
}

remove_eid() {
    local eid=$1
    if mapper get-service /au/com/codeconstruct/mctp1/networks/1/endpoints/"$eid" 2> /dev/null; then
        echo removing eid "$eid"
        busctl call au.com.codeconstruct.MCTP1 \
            "/au/com/codeconstruct/mctp1/networks/1/endpoints/${eid}" \
            au.com.codeconstruct.MCTP.Endpoint1 \
            Remove
    fi
}

is_cx8_ready() {
    local iob_index=$1
    local cur_retry=0
    local cx_ready=0
    local cx_boot=0
    local line_names=(
        "CX_BOOT_CMPLT_CX0"
        "CX_BOOT_CMPLT_CX1"
        "SEC_CX_BOOT_CMPLT_CX0"
        "SEC_CX_BOOT_CMPLT_CX1"
    )
    while [ $cur_retry -lt $MAX_RETRY ]; do
        cur_retry=$((cur_retry + 1))
        cx_ready=0
        if timeout 3 mapper wait "/xyz/openbmc_project/inventory/system/board/NVIDIA_GB300_IO_Board_${iob_index}"; then
            for i in 0 1; do
                local line_name=${line_names[${iob_index} * 2 + $i]}
                cx_boot=$(get_gpio "$line_name")
                echo "${line_name} --> ${cx_boot}"
                if [[ ${cx_boot} -eq 1 ]]; then
                    cx_ready=$((cx_ready + 1))
                fi
            done
            if [[ ${cx_ready} -eq 2 ]]; then
                # extra delay is needed
                sleep 5
                echo "CX8 I/O Mezz ${iob_index} is ready"
                return $cx_ready
            fi
        fi
        echo "Retry $cur_retry/$MAX_RETRY"
        sleep 10
    done
    return $cx_ready
}

remove_endpoints() {
    local ep_regex=".*/endpoints/([0-9]+)"
    local eid=""
    systemctl stop cx-ready.target
    busctl tree au.com.codeconstruct.MCTP1 | grep endpoints/ | while IFS= read -r line; do
        if [[ "$line" =~ $ep_regex ]]; then
            eid=${BASH_REMATCH[1]}
            if [ "$eid" -gt 8 ] && [ "$eid" -lt 90 ]; then
                remove_eid "$eid"
            fi
        fi
    done
}

enum_downstream() {
    local eid=$1
    local idx=$2
    if ! busctl call au.com.codeconstruct.MCTP1 \
        /au/com/codeconstruct/mctp1/networks/1 \
        au.com.codeconstruct.MCTP.Network1 \
        LearnEndpoint y "$eid"; then
        #echo "LearnEndpoint ${eid} Failed."
        return 1
    fi
    cx_eids[$idx]="$eid"
    return 0
}

setup_eid() {
    local mctp_intf=$1
    local iob_index=$2
    local mctp_eid=""
    local num_of_cx=0
    local expected_cx=0
    local res=""
    local outer_retry=0
    local regex="[a-z]+ ([0-9]+) [0-9]+ \".+\" (true|false)"

    is_cx8_ready "$iob_index"
    expected_cx=$?
    while [ $outer_retry -lt 3 ]; do
        outer_retry=$((outer_retry + 1))
        echo "setup_eid ${mctp_intf}: attempt ${outer_retry}/3"
        # Assign EID to MCTP bridge and allocate a contiguous range of EIDs
        # for the bridge's downstream endpoints.
        res=$(
            busctl call au.com.codeconstruct.MCTP1 \
                "/au/com/codeconstruct/mctp1/interfaces/${mctp_intf}" \
                au.com.codeconstruct.MCTP.BusOwner1 \
                AssignEndpoint ay 0
        )
        echo "$res"
        mctp_eid=""
        if [[ $res =~ $regex ]]; then
            mctp_eid=${BASH_REMATCH[1]}
        fi
        if [[ $outer_retry -gt 1 ]]; then
            # Give the SMA more time to settle its downstream CX8s
            # (roughly one settle interval per working CX8) before
            # asking again, instead of the short settle attempt 1 gets,
            # where the CX8s have been up all along.
            sleep $((60 * expected_cx))
        else
            sleep 2
        fi
        echo "Discovering bridged endpoints"
        num_of_cx=0
        local nic_index=0
        for bridged_eid in $((mctp_eid + 2)) $((mctp_eid + 4)); do
            local idx=$((iob_index * 2 + nic_index))
            if enum_downstream "$bridged_eid" "$idx"; then
                num_of_cx=$((num_of_cx + 1))
            fi
            nic_index=$((nic_index + 1))
        done
        echo "setup_eid ${mctp_intf}: downstream endpoint(s) ${num_of_cx}/${expected_cx}"
        if [[ $num_of_cx -eq $expected_cx ]]; then
            break
        fi
        # This attempt didn't fully succeed - remove whatever it created
        # before retrying, so the next attempt starts from a clean slate.
        if [[ $outer_retry -lt 3 ]]; then
            remove_eid "${mctp_eid}"
            for nic_index in 0 1; do
                local idx=$((iob_index * 2 + nic_index))
                if [[ -n ${cx_eids[$idx]:-} ]]; then
                    remove_eid "${cx_eids[$idx]}"
                    unset "cx_eids[$idx]"
                fi
            done
            mctp link set "$mctp_intf" down
            mctp addr del 8 dev "$mctp_intf"
            mctp link set "$mctp_intf" up
            mctp addr add 8 dev "$mctp_intf"
        fi
    done
    if [[ $num_of_cx -eq 0 ]]; then
        return 1
    fi
    return 0
}

setup_sma() {
    local res=0
    if ! setup_eid mcu1u2u2 0; then
        res=1
    fi
    if ! setup_eid mcu1u2u7u2 1; then
        res=1
    fi
    # Start cx-ready.target/pldmd with whatever endpoints were learned,
    # even if one board came up short or failed entirely - a failure on
    # one board shouldn't withhold the other board's already-working
    # sensors. ExternalSensor's own reaper is what marks any missing
    # endpoint's sensors unavailable.
    systemctl start cx-ready.target
    systemctl start pldmd
    return "$res"
}

reset_sma() {
    echo "Resetting SMA ..."
    systemctl stop pldmd
    remove_endpoints
    cx_eids=()
    set_gpio "MCU_RST_N" 0
    set_gpio "SEC_MCU_RST_N" 0
    sleep 1
    set_gpio "MCU_RST_N" 1
    set_gpio "SEC_MCU_RST_N" 1
    sleep 3

    check_and_reset_usb_hub
    sleep 3

    mctp link set mcu1u2u2 up
    mctp link set mcu1u2u7u2 up
    mctp link
    mctp addr add 8 dev mcu1u2u2
    mctp addr add 8 dev mcu1u2u7u2
    mctp addr
    sleep 1
}

###### Temporary functions ######
get_numeric_sensor_by_eid() {
    local eid=$1
    local sensor_id=$2
    local pldmtool_out

    pldmtool_out="$(pldmtool platform GetSensorReading -i "$sensor_id" -r 0 -m "$eid")"
    if echo "$pldmtool_out" | jq 'has("presentReading")' | grep -q true; then
        echo "$pldmtool_out" | jq '.presentReading'
        return 0
    else
        return 1
    fi
}

update_numeric_sensor_value() {
    local eid="$1"
    local sensor_id="$2"
    local sensor_name="$3"
    local sensor_val

    if sensor_val="$(get_numeric_sensor_by_eid "${eid}" "${sensor_id}")"; then
        # The sensor (ID 50) has "unitModifier" = -1 in PDR.
        # The actual reading should be the original value * 0.1.
        if [[ ${sensor_id} -eq 50 ]]; then
            sensor_val="$((sensor_val / 10)).$((sensor_val % 10))"
        fi
        busctl set-property xyz.openbmc_project.ExternalSensor "/xyz/openbmc_project/sensors/$sensor_name" xyz.openbmc_project.Sensor.Value Value d "$sensor_val"
    else
        echo "update_numeric_sensor_value(): pldmtool failed, eid: $eid, sensor_id: $sensor_id, sensor_name: $sensor_name"
    fi
}
###### End of Temporary functions ######

reset_sma

trap "remove_endpoints; exit 0" SIGTERM

setup_sma
# Only exit 1 (letting systemd's Restart=on-failure trigger a fresh
# reset_sma() attempt) when nothing at all was learned - there's
# nothing being served yet to lose. If anything did come up, keep
# running with it instead of tearing down a partially-working result
# just because the other board failed.
if [[ $? -ne 0 && ${#cx_eids[@]} -eq 0 ]]; then
    exit 1
fi

###### Short term solution that is bound to be replaced by pldmd ######
while systemctl is-active --quiet cx-ready.target; do
    for ((i = 0; i < 4; i++)); do
        [[ -z ${cx_eids[$i]:-} ]] && continue
        update_numeric_sensor_value "${cx_eids[$i]}" 300 temperature/IOB$((i / 2))_NIC$((i % 2))_TEMP_C
        update_numeric_sensor_value "${cx_eids[$i]}" 50 power/IOB$((i / 2))_NIC$((i % 2))_PWR_W
        if pldmtool platform GetPDR -m "${cx_eids[$i]}" -t numericsensor | grep -q '"sensorID": 500'; then
            update_numeric_sensor_value "${cx_eids[$i]}" 500 temperature/IOB$((i / 2))_NIC$((i % 2))_OSFP_TEMP_C
        fi
    done
    sleep 2 &
    wait $!
done
###### End of Short term solution ######

exit 0
