#!/bin/bash
# shellcheck source=meta-facebook/meta-bletchley/recipes-bletchley/plat-tools/files/bletchley-common-functions
source /usr/libexec/bletchley-common-functions

SLED_ID=$1
SERVICE_NAME="xyz.openbmc_project.Inventory.Manager"
PRESENT_OBJPATH="/xyz/openbmc_project/inventory/system/chassis/presence/presence_sled${SLED_ID}"
DBUS_PROPERTY_INTF="org.freedesktop.DBus.Properties"

bind_i2c_driver()
{
    I2C_BUS_ADDR=$1
    DRIVER_NAME=$2
    DRIVER_DIR="/sys/bus/i2c/drivers/${DRIVER_NAME}"
    if [ ! -e "${DRIVER_DIR}/${I2C_BUS_ADDR}" ]; then
        echo "${I2C_BUS_ADDR}" > "${DRIVER_DIR}"/bind
    fi
}

unbind_i2c_driver()
{
    I2C_BUS_ADDR=$1
    DRIVER_NAME=$2
    DRIVER_DIR="/sys/bus/i2c/drivers/${DRIVER_NAME}"
    if [ -e "${DRIVER_DIR}/${I2C_BUS_ADDR}" ]; then
        echo "${I2C_BUS_ADDR}" > "${DRIVER_DIR}"/unbind
    fi
}

LEDS_GPIO_DRV="/sys/bus/platform/drivers/leds-gpio"

# The sled LED expander is second-sourced: a PCA9552 at 0x67 or a
# PCA9532 at 0x66. The kernel rejects probe of the absent variant
# (leds-pca9532 phantom-probe fix), so a plain bind attempt doubles
# as presence detection; no i2cget probing is needed.
bind_pca95xx_led()
{
    local bus=$1
    local node="sled${SLED_ID}_gpio_leds"
    local attempt

    # Drop any stale binding left from a previously inserted sled of
    # either variant (consumers first, then the expanders).
    echo "${node}_alt" > "${LEDS_GPIO_DRV}/unbind" 2>/dev/null
    echo "${node}" > "${LEDS_GPIO_DRV}/unbind" 2>/dev/null
    unbind_i2c_driver "${bus}-0066" "leds-pca953x"
    unbind_i2c_driver "${bus}-0067" "leds-pca955x"

    # Bind whichever variant probes. The explicit leds-gpio bind below
    # may race with deferred probe re-binding the node; the consumer
    # starts from a fresh bind either way, so EBUSY here is harmless.
    for attempt in 1 2 3; do
        if bind_i2c_driver "${bus}-0067" "leds-pca955x" 2>/dev/null; then
            echo "SLED${SLED_ID}: PCA9552 LED expander bound"
            echo "${node}" > "${LEDS_GPIO_DRV}/bind" 2>/dev/null
            return 0
        fi
        if bind_i2c_driver "${bus}-0066" "leds-pca953x" 2>/dev/null; then
            echo "SLED${SLED_ID}: PCA9532 LED expander bound"
            echo "${node}_alt" > "${LEDS_GPIO_DRV}/bind" 2>/dev/null
            return 0
        fi
        [ "$attempt" -lt 3 ] && sleep 0.2
    done

    echo "SLED${SLED_ID}: no LED expander responded on bus ${bus}"
    return 1
}

sled_insert_action()
{
    SLED_ID=$1
    local I2C_BUS_NUM
    I2C_BUS_NUM=$(get_bus_num "$SLED_ID")

    # wait for standby power to stabilize
    sleep 0.5

    # 0045: ina230
    bind_i2c_driver "${I2C_BUS_NUM}-0045" "ina2xx"

    # 0040: mp5023
    bind_i2c_driver "${I2C_BUS_NUM}-0040" "mp5023"

    # 0041: pca9536
    bind_i2c_driver "${I2C_BUS_NUM}-0041" "pca953x"

    # 0076: pca9539. provides FUSB302 VBUS‑enable GPIO; fusb302 auto-binds after it probes
    bind_i2c_driver "${I2C_BUS_NUM}-0076" "pca953x"

    # 004f: tmp421
    bind_i2c_driver "${I2C_BUS_NUM}-004f" "tmp421"

    # 0067: pca9552 / 0066: pca9532 (second source)
    bind_pca95xx_led "${I2C_BUS_NUM}"

    # 0054: 24c64
    bind_i2c_driver "${I2C_BUS_NUM}-0054" "at24"

    # Clear LED group state
    systemctl start obmc-led-group-stop@sled"${SLED_ID}"_good.service
    systemctl start obmc-led-group-stop@sled"${SLED_ID}"_identify.service

    # start bletchley-sled-insertion target
    /bin/systemctl start bletchley-sled-insertion@"${SLED_ID}".target
}

sled_remove_action()
{
    SLED_ID=$1
    local I2C_BUS_NUM
    I2C_BUS_NUM=$(get_bus_num "$SLED_ID")

    # 0022: fusb302
    unbind_i2c_driver "${I2C_BUS_NUM}-0022" "typec_fusb302"

    # # 0045: ina230
    # unbind_i2c_driver "${I2C_BUS_NUM}-0045" "ina2xx"

    # # 0040: mp5023
    # unbind_i2c_driver "${I2C_BUS_NUM}-0040" "mp5023"

    # # 0041: pca9536
    # unbind_i2c_driver "${I2C_BUS_NUM}-0041" "pca953x"

    # 0076: pca9539
    unbind_i2c_driver "${I2C_BUS_NUM}-0076" "pca953x"

    # # 004f: tmp421
    # unbind_i2c_driver "${I2C_BUS_NUM}-004f" "tmp421"

    # # 0067: pca9552
    # unbind_i2c_driver "${I2C_BUS_NUM}-0067" "leds-pca955x"

    # # 0054: 24c64
    # unbind_i2c_driver "${I2C_BUS_NUM}-0054" "at24"

    # start bletchley-sled-removal target
    /bin/systemctl start bletchley-sled-removal@"${SLED_ID}".target
}


busctl monitor --system --match "type=signal,interface=${DBUS_PROPERTY_INTF},sender=${SERVICE_NAME},path=${PRESENT_OBJPATH}" |
while read -r line; do
    case "$line" in
        *"BOOLEAN false"*)
            echo "SLED${SLED_ID} Removal"
            sled_remove_action "$SLED_ID"
            ;;
        *"BOOLEAN true"*)
            echo "SLED${SLED_ID} Insertion"
            sled_insert_action "$SLED_ID"
            ;;
    esac
done

exit 0
