[Unit]
Description=RA Gateway Updater
# Doesn't depend on phosphor-networkd: the gateways it persisted for dumb
# NICs are cleared by gbmc-ncsi-clear-gw@, which we start without waiting.
After=systemd-networkd.service
After=ncsid@%i.service
StartLimitIntervalSec=1min
StartLimitBurst=5

[Service]
Restart=always
RestartSec=5
ExecStart=/usr/libexec/gbmc-ncsi-ra.sh %I

[Install]
WantedBy=multi-user.target
