[[ -n ${gbmc_nic_neigh_lib-} ]] && return

# shellcheck source=meta-google/recipes-google/networking/network-sh/lib.sh
source /usr/share/network/lib.sh || exit
# shellcheck source=meta-google/recipes-google/networking/gbmc-net-common/gbmc-net-lib.sh
source /usr/share/gbmc-net-lib.sh || exit

gbmc_nic_neigh_intfs=(@IFS@)
gbmc_nic_neigh_addr=

gbmc_nic_neigh_ips() {
  local -n out_ips="$1"
  local ip="$2"

  local pfx_bytes=()
  ip_to_bytes pfx_bytes "$ip"
  (( pfx_bytes[8] |= 0xfd ))
  out_ips=("$ip")
  local i
  for (( i=1; i<16; ++i )); do
    (( pfx_bytes[9] &= 0xf0 ))
    (( pfx_bytes[9] |= i ))
    out_ips+=("$(ip_bytes_to_str pfx_bytes)")
  done
}

gbmc_nic_neigh_set() {
  local act="$1"
  local ip="$2"

  echo "gBMC NIC Neigh $act $ip: ${gbmc_nic_neigh_intfs[*]}" >&2

  local neigh_ips=()
  gbmc_nic_neigh_ips neigh_ips "$ip"

  local intf
  for intf in "${gbmc_nic_neigh_intfs[@]}"; do
    local rt
    rt="$(gbmc_net_route_table_for_intf "$intf")" || continue
    local neigh_ip
    if [[ "$act" == add ]]; then
      local contents
      read -r -d '' contents <<EOF
[RoutingPolicyRule]
To=$ip/64
Table=main
Priority=$GBMC_INTF_ROUTE_TABLE_BASE
[RoutingPolicyRule]
From=$ip/64
Table=$rt
Priority=$rt
[Network]
IPv6ProxyNDP=yes
EOF
      for neigh_ip in "${neigh_ips[@]}"; do
        contents+=$'\n'"IPv6ProxyNDPAddress=$neigh_ip"
      done
      gbmc_net_networkd_write_dropin "$intf" 10-nic-neigh-table.conf "$contents" || true

      gbmc_net_proxy_ndp_add "$intf" "${neigh_ips[@]}" || true
      gbmc_net_rule_replace to "$ip/64" lookup main pref "$GBMC_INTF_ROUTE_TABLE_BASE" || true
      gbmc_net_rule_replace from "$ip/64" lookup "$rt" pref "$rt" || true
      # Write the necessary firewall rules to forward IP traffic
      local rules
      read -r -d '' rules <<EOF
table inet filter {
  chain ${intf}_forward {
    ip6 saddr != $ip/64 ip6 daddr $ip/64 accept
  }
}
EOF
      gbmc_net_write_if_changed "$rules" \
        /run/nftables/40-gbmc-"$intf"-br.rules || true
    else
      gbmc_net_networkd_write_dropin "$intf" 10-nic-neigh-table.conf '' || true
      for neigh_ip in "${neigh_ips[@]}"; do
        ip -6 neigh del proxy "$neigh_ip" dev "$intf" 2>/dev/null || true
      done
      ip -6 rule del to "$ip/64" lookup main pref "$GBMC_INTF_ROUTE_TABLE_BASE" 2>/dev/null || true
      ip -6 rule del from "$ip/64" lookup "$rt" pref "$rt" 2>/dev/null || true
      gbmc_net_write_if_changed '' \
        /run/nftables/40-gbmc-"$intf"-br.rules || true
    fi
  done
}

gbmc_nic_neigh_hook() {
  # shellcheck disable=SC2154
  if [[ $change == addr && $intf == gbmcbr && $scope == global ]] &&
       [[ $fam == inet6 && $flags != *tentative* ]]; then
    local ip_bytes=()
    if ! ip_to_bytes ip_bytes "$ip"; then
      echo "gBMC Bridge Ensure RA Invalid IP: $ip" >&2
      return 1
    fi
    # Ignore ULAs
    if (( (ip_bytes[0] & 0xfe) == 0xfc )); then
      return 0
    fi
    # Addresses must be /64 to the upstack switch
    for (( i = 8; i < 16; ++i )); do
      if (( ip_bytes[i] != 0 )); then
        return 0
      fi
    done
    if [[ $action == add && "$gbmc_nic_neigh_addr" != "$ip" ]]; then
      if [ -n "$gbmc_nic_neigh_addr" ]; then
        gbmc_nic_neigh_set del "$gbmc_nic_neigh_addr"
      fi
      gbmc_nic_neigh_addr="$ip"
      gbmc_nic_neigh_set add "$ip"
    elif [[ $action == del && "$gbmc_nic_neigh_addr" == "$ip"  ]]; then
      gbmc_nic_neigh_addr=
      gbmc_nic_neigh_set del "$ip"
    fi
  elif [[ $change == link && $action == add && $carrier == UP && -n $gbmc_nic_neigh_addr ]]; then
    local gbmcintf
    for gbmcintf in "${gbmc_nic_neigh_intfs[@]}"; do
      if [[ $intf == "$gbmcintf" ]]; then
        echo "gBMC NIC Neigh carrier UP $gbmc_nic_neigh_addr: $intf" >&2
        local neigh_ips=()
        gbmc_nic_neigh_ips neigh_ips "$gbmc_nic_neigh_addr"
        # networkd has the same proxies in its drop-in, a plain reload
        # wouldn't reapply them as nothing changed
        gbmc_net_proxy_ndp_add "$intf" "${neigh_ips[@]}" || true
      fi
    done
  fi
}

GBMC_IP_MONITOR_HOOKS+=(gbmc_nic_neigh_hook)

gbmc_nic_neigh_lib=1
