#!/bin/bash
# shellcheck source=meta-google/recipes-google/networking/gbmc-net-common/gbmc-net-lib.sh
source /usr/share/gbmc-net-lib.sh || exit

gbmc_net_reload_queue_start
# shellcheck disable=SC2043
for nic in @IFS@; do
  echo "Configuring devlab RA and firewall rules for $nic" >&2
  root=/etc
  if [ -n "${gbmc_net_avoid_rwfs-${GBMC_AVOID_RWFS-}}" ]; then
    root=/run
  fi
  netconfdir="$root/systemd/network/-bmc-${nic}.network.d"
  nftconfdir="$root/nftables"
  read -r -d '' nfcontents <<EOF
table inet filter {
  chain gbmc_br_pub_input {
    udp dport 546 accept
    udp dport 547 accept
  }
}
EOF
  gbmc_net_write_if_changed "$nfcontents" "${nftconfdir}/50-gbmc-$nic-lab.rules" || true
  gbmc_net_write_if_changed "[Network]"$'\n'"IPv6AcceptRA=true" \
    "${netconfdir}/10-ra-config.conf" || true
done
gbmc_net_reload_queue_end

